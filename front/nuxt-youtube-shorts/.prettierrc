{
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 160,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "vueIndentScriptAndStyle": true,
    "htmlWhitespaceSensitivity": "ignore",
    "singleAttributePerLine": false
}